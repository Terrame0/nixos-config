{
  "version": "2.0.0",
  "tasks": 
  [
    {
      "label": "format",
      "type": "shell",
      "command": "alejandra",
      "args": ["${workspaceFolder}", ">/dev/null", "2>&1"],
      "presentation": { "reveal": "never", "showReuseMessage": false }
    },
    {
      "label": "stage",
      "type": "process",
      "command": "git",
      "args": ["add", "${workspaceFolder}"],
      "presentation": { "reveal": "never", "showReuseMessage": false }
    },
    {
      "label": "build",
      "type": "process",
      "command": "nixos",
      "args": [
        "build", 
        "-o", "${workspaceFolder}/.build"
      ],
      "dependsOn":["format", "stage"],
      "dependsOrder": "sequence"
    },
    {
      "label": "run",
      "type": "process",
      "command": "nixos",
      "args": [
        "apply",
        "--store-path" ,
        "${workspaceFolder}/.build"
      ],
      "dependsOn":["build"],
    },
  ]
}
